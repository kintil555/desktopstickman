// Panel pengaturan — gaya pixel GUI dari makespritewithclaude (tekstur 9-slice, font Groundhog, aksen oranye).
// Aset di ui/px/ = salinan makespritewithclaude/assets/ui yang diperbesar 2x (nearest).
import "px/groundhog.ttf";

global Pal {
    out property <color> bg: #161616;
    out property <color> fg: #ece8f5;
    out property <color> mut: #a8a8a8;
    out property <color> acc: #ff8a2a;
}

component PxButton inherits Rectangle {
    in property <string> text;
    in property <bool> active: false;
    in property <bool> accent: false;
    in property <length> size: 18px;
    callback clicked();
    min-height: 36px;
    Image {
        source: @image-url("px/button.png", nine-slice(2 2 4 2));
        width: 100%;
        height: 100%;
        image-rendering: pixelated;
    }
    Rectangle {
        background: root.active ? #ff8a2a30 : (ta.pressed ? #00000070 : (ta.has-hover ? #ffffff14 : transparent));
    }
    Text {
        text: root.text;
        font-size: root.size;
        color: (root.active || root.accent) ? Pal.acc : Pal.fg;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    ta := TouchArea {
        clicked => { root.clicked(); }
    }
}

component PxCheck inherits Rectangle {
    in-out property <bool> checked;
    in property <string> text;
    callback toggled();
    height: 32px;
    HorizontalLayout {
        spacing: 8px;
        alignment: start;
        Rectangle {
            width: 32px;
            height: 32px;
            Image {
                source: @image-url("px/field.png");
                width: 100%;
                height: 100%;
                image-fit: fill;
                image-rendering: pixelated;
            }
            if root.checked : Rectangle {
                x: 8px;
                y: 8px;
                width: 16px;
                height: 16px;
                background: Pal.acc;
            }
        }
        Text {
            text: root.text;
            color: Pal.fg;
            vertical-alignment: center;
        }
    }
    TouchArea {
        clicked => {
            root.checked = !root.checked;
            root.toggled();
        }
    }
}

component PxSlider inherits Rectangle {
    in-out property <float> value;
    in property <float> minimum: 0;
    in property <float> maximum: 1;
    callback edited();
    callback released();
    height: 32px;
    property <length> span: root.width - 32px;
    property <float> frac: root.maximum > root.minimum ? Math.clamp((root.value - root.minimum) / (root.maximum - root.minimum), 0, 1) : 0;
    function apply(x: length) {
        root.value = root.minimum + Math.clamp((x - 16px) / root.span, 0, 1) * (root.maximum - root.minimum);
        root.edited();
    }
    Image {
        source: @image-url("px/field.png");
        width: 100%;
        height: 100%;
        image-fit: fill;
        image-rendering: pixelated;
    }
    Image {
        source: @image-url("px/fill.png");
        x: 0;
        width: root.span * root.frac + 16px;
        height: 100%;
        image-fit: fill;
        image-rendering: pixelated;
    }
    Image {
        source: @image-url("px/slider-head.png");
        x: root.span * root.frac;
        width: 32px;
        height: 32px;
        image-rendering: pixelated;
    }
    TouchArea {
        pointer-event(e) => {
            if (e.button == PointerEventButton.left) {
                if (e.kind == PointerEventKind.down) {
                    root.apply(self.mouse-x);
                } else if (e.kind == PointerEventKind.up) {
                    root.released();
                }
            }
        }
        moved => {
            if (self.pressed) {
                root.apply(self.mouse-x);
            }
        }
    }
}

component PxStep inherits Rectangle {
    in-out property <int> value;
    in property <int> minimum: 0;
    in property <int> maximum: 99;
    callback changed();
    height: 32px;
    HorizontalLayout {
        spacing: 2px;
        PxButton {
            text: "-";
            width: 28px;
            min-height: 32px;
            clicked => {
                if (root.value > root.minimum) {
                    root.value -= 1;
                    root.changed();
                }
            }
        }
        Rectangle {
            horizontal-stretch: 1;
            Image {
                source: @image-url("px/field.png");
                width: 100%;
                height: 100%;
                image-fit: fill;
                image-rendering: pixelated;
            }
            Text {
                text: "" + root.value;
                color: Pal.fg;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
        PxButton {
            text: "+";
            width: 28px;
            min-height: 32px;
            clicked => {
                if (root.value < root.maximum) {
                    root.value += 1;
                    root.changed();
                }
            }
        }
    }
}

component PxInput inherits Rectangle {
    in-out property <string> text <=> ti.text;
    callback accepted();
    height: 32px;
    Image {
        source: @image-url("px/field.png");
        width: 100%;
        height: 100%;
        image-fit: fill;
        image-rendering: pixelated;
    }
    ti := TextInput {
        x: 10px;
        width: parent.width - 20px;
        height: parent.height;
        color: Pal.fg;
        single-line: true;
        vertical-alignment: center;
        accepted => { root.accepted(); }
    }
}

component Label inherits Text {
    color: Pal.mut;
    font-size: 16px;
    height: 22px;
}

component KeyRow inherits Rectangle {
    in property <string> value;
    in property <bool> rec;
    callback pick();
    callback clear();
    height: 36px;
    HorizontalLayout {
        spacing: 6px;
        PxButton {
            text: root.rec ? "Tekan tombol... (Esc = batal)" : (root.value == "" ? "Belum diatur - klik lalu tekan tombol" : root.value);
            size: 16px;
            active: root.rec;
            clicked => { root.pick(); }
        }
        PxButton {
            text: "X";
            width: 44px;
            clicked => { root.clear(); }
        }
    }
}

export struct ItemRow {
    id: int,
    name: string,
    sel: bool,
    worn: bool,
}

export struct InstRow {
    id: int,
    name: string,
    color: color,
    sel: bool,
}

export component Panel inherits Window {
    title: "Desktop Stickman";
    width: 940px;
    height: 700px;
    background: Pal.bg;
    default-font-family: "Pixel Font - Groundhog";
    default-font-size: 18px;

    in-out property <int> tab: 0;
    in-out property <bool> running: false;
    // Umum
    in-out property <float> speed: 1.0;
    in-out property <float> cell: 2;
    in-out property <float> floor-offset: 48;
    in-out property <float> volume: 0.6;
    in-out property <bool> jump: true;
    in-out property <bool> run: true;
    in-out property <bool> fly: true;
    in-out property <bool> dust: true;
    in-out property <bool> hang: true;
    in-out property <bool> sound: true;
    // Warna (satu color wheel; warna belakang otomatis)
    in-out property <image> wheel;
    in-out property <float> hue: 0;
    in-out property <float> sat: 0;
    in-out property <float> val: 1;
    in-out property <string> hex: "#EE7A1C";
    in-out property <color> preview: #EE7A1C;
    // Shadow
    in-out property <bool> shadow: true;
    in-out property <float> shadow-opacity: 0.4;
    in-out property <float> shadow-dx: 4;
    in-out property <float> shadow-dy: 4;
    in-out property <float> shadow-blur: 1;
    in-out property <string> shadow-hex: "#000000";
    // Model (skin)
    in-out property <bool> skin-on: false;
    in-out property <string> skin-path;
    in-out property <int> sk-cols: 4;
    in-out property <int> sk-rows: 4;
    in-out property <float> sk-scale: 2;
    in-out property <float> sk-seat: 0.6;
    in-out property <int> sk-offx: 0;
    in-out property <int> sk-offy: 0;
    in-out property <bool> sk-left: false;
    in-out property <bool> sk-tint: false;
    in-out property <int> ai-row: 0;
    in-out property <int> ai-fr: 4;
    in-out property <int> ai-fps: 4;
    in-out property <int> aw-row: 1;
    in-out property <int> aw-fr: 4;
    in-out property <int> aw-fps: 8;
    in-out property <int> ar-row: 2;
    in-out property <int> ar-fr: 4;
    in-out property <int> ar-fps: 12;
    in-out property <int> aj-row: 3;
    in-out property <int> aj-fr: 1;
    in-out property <int> aj-fps: 1;
    // Sistem
    in-out property <bool> autostart: false;
    in-out property <float> delay: 30;
    in-out property <bool> bg-close: true;
    // Model (bentuk prosedural)
    in-out property <image> preview-img;
    in-out property <image> grid-img;
    in-out property <bool> grid-ok: false;
    in-out property <bool> b-head-fill: false;
    in-out property <float> b-head-size: 1;
    in-out property <float> b-head-w: 2;
    in-out property <float> b-limb-w: 2;
    in-out property <float> b-torso-w: 2;
    in-out property <bool> b-outline: true;
    in-out property <string> b-outline-hex: "#28140A";
    in-out property <bool> b-shade: true;
    in-out property <float> b-shade-k: 1;
    in-out property <float> b-back-k: 0.75;
    // Tombol pintas
    in-out property <string> key-hang;
    in-out property <string> key-jump;
    in-out property <string> key-fly;
    in-out property <string> key-hide;
    in-out property <string> key-item;
    // Item yang dipegang
    in-out property <[ItemRow]> item-rows;
    in-out property <int> sel-item: 0;
    in-out property <int> held-id: 0;
    in-out property <bool> item-back: false;
    in-out property <bool> item-follow: false;
    in-out property <bool> item-flip: true;
    in-out property <float> item-off-x: 0;
    in-out property <float> item-off-y: 0;
    in-out property <float> item-scale: 1;
    in-out property <float> item-angle: 0;
    in-out property <float> item-pvx: 0.15;
    in-out property <float> item-pvy: 0.85;
    // 0 = tidak merekam; 1..4 = hang/jump/fly/hide sedang merekam
    in-out property <int> recording: 0;
    in-out property <int> count: 0;
    // Daftar stickman
    in-out property <[InstRow]> insts;
    in-out property <int> sel-id: 0;
    in-out property <string> target-name: "Default";

    callback toggle();
    callback changed();
    callback wheel-pick(float, float);
    callback color-edited();
    callback hex-accepted();
    callback shadow-hex-accepted();
    callback pick-skin();
    callback autostart-changed();
    callback quit-panel();
    callback keys-accepted();
    callback record(int);
    callback spawn-more();
    callback inst-select(int);
    callback item-add();
    callback item-select(int);
    callback item-wear(int);
    callback item-delete(int);
    callback item-changed();
    callback inst-delete(int);

    Image {
        source: @image-url("px/gui.png", nine-slice(6));
        width: 100%;
        height: 100%;
        image-rendering: pixelated;
    }

    HorizontalLayout {
        padding: 16px;
        spacing: 12px;

        VerticalLayout {
        spacing: 8px;
        horizontal-stretch: 1;

        Rectangle {
            height: 44px;
            Image {
                source: @image-url("px/web-header.png", nine-slice(2 2 6 2));
                width: 100%;
                height: 100%;
                image-rendering: pixelated;
            }
            Text {
                x: 14px;
                text: "Desktop Stickman";
                color: Pal.acc;
                font-size: 22px;
                vertical-alignment: center;
            }
            Text {
                x: parent.width - self.width - 14px;
                text: root.running ? "jalan (" + root.count + ")" : "berhenti";
                color: root.running ? Pal.acc : Pal.mut;
                font-size: 16px;
                vertical-alignment: center;
            }
        }

        HorizontalLayout {
            spacing: 4px;
            PxButton { text: "Umum"; size: 15px; active: root.tab == 0; clicked => { root.tab = 0; } }
            PxButton { text: "Warna"; size: 15px; active: root.tab == 1; clicked => { root.tab = 1; } }
            PxButton { text: "Shadow"; size: 15px; active: root.tab == 2; clicked => { root.tab = 2; } }
            PxButton { text: "Model"; size: 15px; active: root.tab == 6; clicked => { root.tab = 6; } }
            PxButton { text: "Skin"; size: 15px; active: root.tab == 3; clicked => { root.tab = 3; } }
            PxButton { text: "Anim"; size: 15px; active: root.tab == 4; clicked => { root.tab = 4; } }
            PxButton { text: "Tombol"; size: 15px; active: root.tab == 7; clicked => { root.tab = 7; } }
            PxButton { text: "Item"; size: 15px; active: root.tab == 9; clicked => { root.tab = 9; } }
            PxButton { text: "Daftar"; size: 15px; active: root.tab == 8; clicked => { root.tab = 8; } }
            PxButton { text: "Sistem"; size: 15px; active: root.tab == 5; clicked => { root.tab = 5; } }
        }

        Rectangle {
            vertical-stretch: 1;
            clip: true;

            if root.tab == 0 : VerticalLayout {
                spacing: 4px;
                alignment: start;
                Label { text: "Kecepatan: " + Math.round(root.speed * 10) / 10; }
                PxSlider { minimum: 0.1; maximum: 3; value <=> root.speed; released => { root.changed(); } }
                Label { text: "Skala sel (px): " + Math.round(root.cell); }
                PxSlider { minimum: 1; maximum: 8; value <=> root.cell; released => { root.changed(); } }
                Label { text: "Offset lantai/taskbar (px): " + Math.round(root.floor-offset); }
                PxSlider { minimum: 0; maximum: 200; value <=> root.floor-offset; released => { root.changed(); } }
                Label { text: "Volume: " + Math.round(root.volume * 100) + "%"; }
                PxSlider { value <=> root.volume; released => { root.changed(); } }
                Rectangle { height: 6px; }
                HorizontalLayout {
                    PxCheck { text: "Lompat"; checked <=> root.jump; toggled => { root.changed(); } }
                    PxCheck { text: "Lari"; checked <=> root.run; toggled => { root.changed(); } }
                    PxCheck { text: "Terbang"; checked <=> root.fly; toggled => { root.changed(); } }
                }
                HorizontalLayout {
                    PxCheck { text: "Debu"; checked <=> root.dust; toggled => { root.changed(); } }
                    PxCheck { text: "Suara"; checked <=> root.sound; toggled => { root.changed(); } }
                    PxCheck { text: "Gantung"; checked <=> root.hang; toggled => { root.changed(); } }
                }
                Label { text: "Tahan klik kanan di stickman = ikut kursor, lepas = turun."; }
                Label { text: "Tombol pintas (tab Tombol) di atas stickman = ikut, tekan lagi = lepas."; }
                Label { text: "Tombol Tambah (bawah) = spawn stickman lagi."; }
            }

            if root.tab == 1 : VerticalLayout {
                spacing: 6px;
                alignment: start;
                Label { text: "Satu warna; badan belakang otomatis"; }
                HorizontalLayout {
                    spacing: 16px;
                    alignment: center;
                    Rectangle {
                        width: 160px;
                        height: 160px;
                        Image {
                            source: root.wheel;
                            width: 100%;
                            height: 100%;
                            image-rendering: pixelated;
                        }
                        Rectangle {
                            x: 80px + Math.cos(root.hue * 1deg) * root.sat * 80px - 6px;
                            y: 80px - Math.sin(root.hue * 1deg) * root.sat * 80px - 6px;
                            width: 12px;
                            height: 12px;
                            border-width: 2px;
                            border-color: #ffffff;
                            background: root.preview;
                        }
                        TouchArea {
                            pointer-event(e) => {
                                if (e.button == PointerEventButton.left) {
                                    if (e.kind == PointerEventKind.down) {
                                        root.wheel-pick(self.mouse-x / 1px, self.mouse-y / 1px);
                                    } else if (e.kind == PointerEventKind.up) {
                                        root.changed();
                                    }
                                }
                            }
                            moved => {
                                if (self.pressed) {
                                    root.wheel-pick(self.mouse-x / 1px, self.mouse-y / 1px);
                                }
                            }
                        }
                    }
                    Rectangle {
                        width: 96px;
                        height: 160px;
                        Image {
                            source: @image-url("px/field.png");
                            width: 100%;
                            height: 100%;
                            image-fit: fill;
                            image-rendering: pixelated;
                        }
                        Rectangle {
                            x: 8px;
                            y: 8px;
                            width: parent.width - 16px;
                            height: parent.height - 16px;
                            background: root.preview;
                        }
                    }
                }
                Label { text: "Terang: " + Math.round(root.val * 100) + "%"; }
                PxSlider {
                    minimum: 0;
                    maximum: 1;
                    value <=> root.val;
                    edited => { root.color-edited(); }
                    released => { root.changed(); }
                }
                Label { text: "Hex"; }
                PxInput { text <=> root.hex; accepted => { root.hex-accepted(); } }
            }

            if root.tab == 2 : VerticalLayout {
                spacing: 4px;
                alignment: start;
                PxCheck { text: "Drop shadow"; checked <=> root.shadow; toggled => { root.changed(); } }
                Label { text: "Opasitas: " + Math.round(root.shadow-opacity * 100) + "%"; }
                PxSlider { value <=> root.shadow-opacity; released => { root.changed(); } }
                Label { text: "Geser X (px): " + Math.round(root.shadow-dx); }
                PxSlider { minimum: -32; maximum: 32; value <=> root.shadow-dx; released => { root.changed(); } }
                Label { text: "Geser Y (px): " + Math.round(root.shadow-dy); }
                PxSlider { minimum: -32; maximum: 32; value <=> root.shadow-dy; released => { root.changed(); } }
                Label { text: "Blur (sel): " + Math.round(root.shadow-blur); }
                PxSlider { minimum: 0; maximum: 4; value <=> root.shadow-blur; released => { root.changed(); } }
                Label { text: "Warna shadow (hex)"; }
                PxInput { text <=> root.shadow-hex; accepted => { root.shadow-hex-accepted(); } }
            }

            if root.tab == 3 : VerticalLayout {
                spacing: 4px;
                alignment: start;
                PxCheck { text: "Pakai sprite sendiri"; checked <=> root.skin-on; toggled => { root.changed(); } }
                Label { text: "File PNG sprite sheet"; }
                HorizontalLayout {
                    spacing: 4px;
                    PxInput { text <=> root.skin-path; accepted => { root.changed(); } }
                    PxButton { text: "Pilih"; width: 80px; clicked => { root.pick-skin(); } }
                }
                HorizontalLayout {
                    spacing: 8px;
                    VerticalLayout {
                        Label { text: "Kolom"; }
                        PxStep { minimum: 1; maximum: 32; value <=> root.sk-cols; changed => { root.changed(); } }
                    }
                    VerticalLayout {
                        Label { text: "Baris"; }
                        PxStep { minimum: 1; maximum: 32; value <=> root.sk-rows; changed => { root.changed(); } }
                    }
                    VerticalLayout {
                        Label { text: "Geser X"; }
                        PxStep { minimum: -64; maximum: 64; value <=> root.sk-offx; changed => { root.changed(); } }
                    }
                    VerticalLayout {
                        Label { text: "Geser Y"; }
                        PxStep { minimum: -64; maximum: 64; value <=> root.sk-offy; changed => { root.changed(); } }
                    }
                }
                Label { text: "Ukuran piksel sprite (px): " + Math.round(root.sk-scale * 10) / 10; }
                PxSlider { minimum: 0.5; maximum: 16; value <=> root.sk-scale; released => { root.changed(); } }
                Label { text: "Skala saat duduk di kendaraan: " + Math.round(root.sk-seat * 100) + "%"; }
                PxSlider { minimum: 0.2; maximum: 2; value <=> root.sk-seat; released => { root.changed(); } }
                HorizontalLayout {
                    PxCheck { text: "Sprite hadap kiri"; checked <=> root.sk-left; toggled => { root.changed(); } }
                    PxCheck { text: "Tint warna"; checked <=> root.sk-tint; toggled => { root.changed(); } }
                }
            }

            if root.tab == 4 : VerticalLayout {
                spacing: 6px;
                alignment: start;
                Label { text: "Animasi per state: baris di sheet, jumlah frame, fps"; }
                HorizontalLayout {
                    spacing: 8px;
                    Label { text: "State"; width: 76px; }
                    Label { text: "Baris"; horizontal-stretch: 1; }
                    Label { text: "Frame"; horizontal-stretch: 1; }
                    Label { text: "FPS"; horizontal-stretch: 1; }
                }
                HorizontalLayout {
                    spacing: 8px;
                    Text { text: "Idle"; width: 76px; color: Pal.fg; vertical-alignment: center; }
                    PxStep { maximum: 31; value <=> root.ai-row; changed => { root.changed(); } }
                    PxStep { minimum: 1; maximum: 32; value <=> root.ai-fr; changed => { root.changed(); } }
                    PxStep { minimum: 1; maximum: 60; value <=> root.ai-fps; changed => { root.changed(); } }
                }
                HorizontalLayout {
                    spacing: 8px;
                    Text { text: "Jalan"; width: 76px; color: Pal.fg; vertical-alignment: center; }
                    PxStep { maximum: 31; value <=> root.aw-row; changed => { root.changed(); } }
                    PxStep { minimum: 1; maximum: 32; value <=> root.aw-fr; changed => { root.changed(); } }
                    PxStep { minimum: 1; maximum: 60; value <=> root.aw-fps; changed => { root.changed(); } }
                }
                HorizontalLayout {
                    spacing: 8px;
                    Text { text: "Lari"; width: 76px; color: Pal.fg; vertical-alignment: center; }
                    PxStep { maximum: 31; value <=> root.ar-row; changed => { root.changed(); } }
                    PxStep { minimum: 1; maximum: 32; value <=> root.ar-fr; changed => { root.changed(); } }
                    PxStep { minimum: 1; maximum: 60; value <=> root.ar-fps; changed => { root.changed(); } }
                }
                HorizontalLayout {
                    spacing: 8px;
                    Text { text: "Lompat"; width: 76px; color: Pal.fg; vertical-alignment: center; }
                    PxStep { maximum: 31; value <=> root.aj-row; changed => { root.changed(); } }
                    PxStep { minimum: 1; maximum: 32; value <=> root.aj-fr; changed => { root.changed(); } }
                    PxStep { minimum: 1; maximum: 60; value <=> root.aj-fps; changed => { root.changed(); } }
                }
                Label { text: "Baris dihitung dari 0 (atas). Frame ke kanan dari kolom 0."; }
            }

            if root.tab == 6 : HorizontalLayout {
                spacing: 16px;
                VerticalLayout {
                    spacing: 4px;
                    alignment: start;
                    horizontal-stretch: 1;
                    PxCheck { text: "Kepala terisi"; checked <=> root.b-head-fill; toggled => { root.changed(); } }
                    Label { text: "Ukuran kepala: " + Math.round(root.b-head-size * 100) + "%"; }
                    PxSlider { minimum: 0.5; maximum: 2; value <=> root.b-head-size; released => { root.changed(); } }
                    Label { text: "Tebal garis kepala: " + Math.round(root.b-head-w * 10) / 10; }
                    PxSlider { minimum: 1; maximum: 6; value <=> root.b-head-w; released => { root.changed(); } }
                    PxCheck { text: "Outline"; checked <=> root.b-outline; toggled => { root.changed(); } }
                    Label { text: "Warna outline (hex)"; }
                    PxInput { text <=> root.b-outline-hex; accepted => { root.changed(); } }
                }
                VerticalLayout {
                    spacing: 4px;
                    alignment: start;
                    horizontal-stretch: 1;
                    Label { text: "Tebal tangan/kaki: " + Math.round(root.b-limb-w * 10) / 10; }
                    PxSlider { minimum: 1; maximum: 6; value <=> root.b-limb-w; released => { root.changed(); } }
                    Label { text: "Tebal badan: " + Math.round(root.b-torso-w * 10) / 10; }
                    PxSlider { minimum: 1; maximum: 6; value <=> root.b-torso-w; released => { root.changed(); } }
                    PxCheck { text: "Shading"; checked <=> root.b-shade; toggled => { root.changed(); } }
                    Label { text: "Kekuatan shading: " + Math.round(root.b-shade-k * 100) + "%"; }
                    PxSlider { minimum: 0; maximum: 2; value <=> root.b-shade-k; released => { root.changed(); } }
                    Label { text: "Terang sisi belakang: " + Math.round(root.b-back-k * 100) + "%"; }
                    PxSlider { minimum: 0.3; maximum: 1; value <=> root.b-back-k; released => { root.changed(); } }
                }
            }

            if root.tab == 7 : VerticalLayout {
                spacing: 4px;
                alignment: start;
                Label { text: "Tombol pintas global (Windows). Klik kotak, lalu tekan"; }
                Label { text: "tombol/kombinasi (mis. Alt+C). X = hapus."; }
                Rectangle { height: 6px; }
                Label { text: "Ikut kursor (arahkan ke stickman, tekan lagi = lepas)"; }
                KeyRow { value: root.key-hang; rec: root.recording == 1; pick => { root.record(root.recording == 1 ? 0 : 1); } clear => { root.recording = 0; root.key-hang = ""; root.keys-accepted(); } }
                Label { text: "Lompat"; }
                KeyRow { value: root.key-jump; rec: root.recording == 2; pick => { root.record(root.recording == 2 ? 0 : 2); } clear => { root.recording = 0; root.key-jump = ""; root.keys-accepted(); } }
                Label { text: "Panggil kendaraan"; }
                KeyRow { value: root.key-fly; rec: root.recording == 3; pick => { root.record(root.recording == 3 ? 0 : 3); } clear => { root.recording = 0; root.key-fly = ""; root.keys-accepted(); } }
                Label { text: "Sembunyikan / tampilkan stickman"; }
                KeyRow { value: root.key-hide; rec: root.recording == 4; pick => { root.record(root.recording == 4 ? 0 : 4); } clear => { root.recording = 0; root.key-hide = ""; root.keys-accepted(); } }
                Label { text: "Ganti item yang dipegang (siklus)"; }
                KeyRow { value: root.key-item; rec: root.recording == 5; pick => { root.record(root.recording == 5 ? 0 : 5); } clear => { root.recording = 0; root.key-item = ""; root.keys-accepted(); } }
            }

            if root.tab == 9 : VerticalLayout {
                spacing: 4px;
                alignment: start;
                HorizontalLayout {
                    spacing: 6px;
                    PxButton { text: "Tambah gambar (PNG)"; size: 16px; clicked => { root.item-add(); } }
                    PxButton { text: "Tangan kosong"; size: 16px; clicked => { if (root.held-id != 0) { root.item-wear(root.held-id); } } }
                }
                Flickable {
                    height: 110px;
                    VerticalLayout {
                        spacing: 4px;
                        for r in root.item-rows : HorizontalLayout {
                            height: 30px;
                            spacing: 6px;
                            PxButton { text: r.name; active: r.sel; clicked => { root.item-select(r.id); } }
                            PxButton { text: r.worn ? "Dipakai" : "Pakai"; width: 90px; active: r.worn; clicked => { root.item-wear(r.id); } }
                            PxButton { text: "Hapus"; width: 80px; clicked => { root.item-delete(r.id); } }
                        }
                    }
                }
                if root.sel-item == 0 : Label { text: "Pilih item di daftar untuk mengatur posisinya."; }
                if root.sel-item != 0 : VerticalLayout {
                    spacing: 2px;
                    Label { text: "Titik genggam = bagian gambar yang menempel di tangan."; }
                    HorizontalLayout {
                        spacing: 10px;
                        VerticalLayout {
                            Label { text: "Geser X: " + Math.round(root.item-off-x); }
                            PxSlider { minimum: -60; maximum: 60; value <=> root.item-off-x; released => { root.item-changed(); } }
                        }
                        VerticalLayout {
                            Label { text: "Geser Y: " + Math.round(root.item-off-y); }
                            PxSlider { minimum: -60; maximum: 60; value <=> root.item-off-y; released => { root.item-changed(); } }
                        }
                    }
                    HorizontalLayout {
                        spacing: 10px;
                        VerticalLayout {
                            Label { text: "Skala: " + Math.round(root.item-scale * 100) / 100; }
                            PxSlider { minimum: 0.25; maximum: 8; value <=> root.item-scale; released => { root.item-changed(); } }
                        }
                        VerticalLayout {
                            Label { text: "Sudut: " + Math.round(root.item-angle); }
                            PxSlider { minimum: -180; maximum: 180; value <=> root.item-angle; released => { root.item-changed(); } }
                        }
                    }
                    HorizontalLayout {
                        spacing: 10px;
                        VerticalLayout {
                            Label { text: "Genggam X: " + Math.round(root.item-pvx * 100) / 100; }
                            PxSlider { minimum: 0; maximum: 1; value <=> root.item-pvx; released => { root.item-changed(); } }
                        }
                        VerticalLayout {
                            Label { text: "Genggam Y: " + Math.round(root.item-pvy * 100) / 100; }
                            PxSlider { minimum: 0; maximum: 1; value <=> root.item-pvy; released => { root.item-changed(); } }
                        }
                    }
                    HorizontalLayout {
                        PxCheck { text: "Tangan belakang"; checked <=> root.item-back; toggled => { root.item-changed(); } }
                        PxCheck { text: "Ikut lengan"; checked <=> root.item-follow; toggled => { root.item-changed(); } }
                        PxCheck { text: "Balik"; checked <=> root.item-flip; toggled => { root.item-changed(); } }
                    }
                }
            }

            if root.tab == 8 : VerticalLayout {
                spacing: 4px;
                alignment: start;
                Label { text: "Pilih stickman: semua tab mengatur yang terpilih."; }
                PxButton { text: "Default (untuk stickman baru)"; size: 16px; active: root.sel-id == 0; clicked => { root.inst-select(0); } }
                Flickable {
                    height: 200px;
                    VerticalLayout {
                        spacing: 4px;
                        for r in root.insts : HorizontalLayout {
                            height: 32px;
                            spacing: 6px;
                            Rectangle { width: 24px; background: r.color; }
                            PxButton { text: r.name; active: r.sel; clicked => { root.inst-select(r.id); } }
                            PxButton { text: "Hapus"; width: 80px; clicked => { root.inst-delete(r.id); } }
                        }
                    }
                }
                Label { text: "Tambah + (bawah) = stickman baru, warna otomatis beda."; }
            }

            if root.tab == 5 : VerticalLayout {
                spacing: 6px;
                alignment: start;
                PxCheck { text: "Jalan otomatis saat login"; checked <=> root.autostart; toggled => { root.autostart-changed(); } }
                Label { text: "Delay start: " + Math.round(root.delay) + " detik"; }
                PxSlider { minimum: 0; maximum: 300; value <=> root.delay; released => { root.autostart-changed(); } }
                Label { text: "Saat delay, proses tidur penuh (0% CPU), lalu overlay mulai."; }
                Rectangle { height: 8px; }
                PxCheck { text: "Tetap jalan saat panel ditutup"; checked <=> root.bg-close; toggled => { root.changed(); } }
                Label { text: "Overlay = proses terpisah, prioritas rendah, ~30 fps saat diam,"; }
                Label { text: "frame tidak berubah tidak digambar ulang. Panel bisa ditutup."; }
            }
        }

        HorizontalLayout {
            height: 44px;
            spacing: 8px;
            PxButton {
                text: root.running ? "Stop" : "Start";
                accent: true;
                clicked => { root.toggle(); }
            }
            PxButton {
                text: "Tambah +";
                clicked => { root.spawn-more(); }
            }
            PxButton {
                text: "Tutup panel";
                clicked => { root.quit-panel(); }
            }
        }
        }

        VerticalLayout {
            width: 320px;
            spacing: 8px;
            alignment: start;

            Rectangle {
                height: 44px;
                Image {
                    source: @image-url("px/web-header.png", nine-slice(2 2 6 2));
                    width: 100%;
                    height: 100%;
                    image-rendering: pixelated;
                }
                Text {
                    x: 14px;
                    text: "Mengatur: " + root.target-name;
                    color: Pal.acc;
                    font-size: 22px;
                    vertical-alignment: center;
                }
            }
            Rectangle {
                width: 320px;
                height: 320px;
                Image {
                    source: @image-url("px/field.png");
                    width: 100%;
                    height: 100%;
                    image-fit: fill;
                    image-rendering: pixelated;
                }
                Image {
                    x: 10px;
                    y: 10px;
                    width: 300px;
                    height: 300px;
                    source: root.preview-img;
                    image-fit: fill;
                    image-rendering: pixelated;
                }
            }
            if root.tab != 3 && root.tab != 4 : VerticalLayout {
                spacing: 8px;
                Label { text: "Berlari lalu diam, berulang."; }
                Label { text: "Warna, bentuk, dan shadow tampil langsung."; }
            }
            if root.tab == 3 || root.tab == 4 : VerticalLayout {
                spacing: 4px;
                Rectangle {
                    width: 320px;
                    height: 210px;
                    Image {
                        source: @image-url("px/field.png");
                        width: 100%;
                        height: 100%;
                        image-fit: fill;
                        image-rendering: pixelated;
                    }
                    Image {
                        x: 10px;
                        y: 10px;
                        width: 300px;
                        height: 190px;
                        source: root.grid-img;
                        image-fit: contain;
                        image-rendering: pixelated;
                        visible: root.grid-ok;
                    }
                    Text {
                        text: "Sprite belum dimuat";
                        color: Pal.mut;
                        font-size: 16px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        visible: !root.grid-ok;
                    }
                }
                Label { text: "Grid sprite. Angka kiri = nomor baris."; }
                HorizontalLayout {
                    spacing: 10px;
                    height: 22px;
                    Text { text: "idle"; color: #50c85a; font-size: 16px; }
                    Text { text: "jalan"; color: #468cff; font-size: 16px; }
                    Text { text: "lari"; color: #ff5050; font-size: 16px; }
                    Text { text: "lompat"; color: #ffdc3c; font-size: 16px; }
                }
            }
        }
    }
}
